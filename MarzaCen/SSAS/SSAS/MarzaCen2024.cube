CREATE MEMBER CURRENTCUBE.[Measures].[Realizacja targetu sprzedaży brutto]
 AS IIF([Measures].[Target sprzedaży brutto]=NULL,NULL,[Measures].[Sprzedaż brutto]/[Measures].[Target sprzedaży brutto]), 
