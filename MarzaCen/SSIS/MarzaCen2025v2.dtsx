          SQLTask:SqlStatementSource="/*Pobranie wymaganych wartości z bazy Sprzedaż*/&#xA;&#xA;INSERT INTO MarzaCen.dbo.TB_Sprzedaz2025_Tv2&#xA;&#xA;SELECT     &#xA;&#x9;A.data_ID,&#xA;&#x9;A.sklep_ID,&#xA;&#x9;SUM(A.wartosc) AS wartoscSprzedazyBrutto,&#xA;&#x9;SUM(A.wartosc / (1 + stawkaVat)) AS wartoscSprzedazyBruttoVAT,&#xA;&#x9;towar_grupa_m&#xA;FROM         &#xA;&#x9;TB_Sprzedaz2025_F A INNER JOIN&#xA;&#x9;SL_Towar_W_2025 B ON A.towar_ID = B.id_towaru_centr INNER JOIN&#xA;&#x9;MarzaCen.dbo.WK_StawkaVAT_T C ON A.vat = C.stawkaVat_Nazwa&#xA;&#xA;WHERE&#xA;&#xA;data_id &gt;='20250101' and data_id &lt;='20251231'&#xA;&#xA;GROUP BY&#xA;&#x9;A.data_ID,&#xA;&#x9;A.sklep_ID,&#xA;&#x9;towar_grupa_m" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
