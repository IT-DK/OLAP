              description="OLE DB Source"
              name="OLE DB Source"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=15.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT
	A.czas_ID,
	A.sklep_ID,

	SUM(a.wartoscSprzedazyBrutto) AS wartoscSprzedazyBrutto,
	SUM(wartoscSprzedazyBruttoTarget) AS wartoscSprzedazyBruttoTarget,
	towar_grupa_m

FROM (
	SELECT
		A.czas_ID,
		A.sklep_ID,
		a.wartoscSprzedazyBrutto,
		wartoscSprzedazyBruttoTarget,
		a.towar_grupa_m

	FROM
		TB_Sprzedaz2025_Tv2 A INNER JOIN
		TB_Target2025_Tv2 B ON A.czas_ID = B.czas_ID
			         AND A.sklep_ID = B.sklep_ID
					 and a.towar_grupa_m = b.towar_grupa_m

	UNION ALL

	SELECT
		A.czas_ID,
		A.sklep_ID,
		b.wartoscSprzedazyBrutto,
		wartoscSprzedazyBruttoTarget,
a.towar_grupa_m

	FROM
		TB_Target2025_Tv2 A LEFT OUTER JOIN
		TB_Sprzedaz2025_Tv2 B ON A.czas_ID = B.czas_ID
			             AND A.sklep_ID = B.sklep_ID
						 and a.towar_grupa_m = b.towar_grupa_m

	WHERE
		B.czas_ID IS NULL
		AND B.sklep_ID IS NULL
		

	UNION ALL

	SELECT
		A.czas_ID,
		A.sklep_ID,

		a.wartoscSprzedazyBrutto,
		wartoscSprzedazyBruttoTarget,
a.towar_grupa_m

	FROM
		TB_Sprzedaz2025_Tv2 A LEFT OUTER JOIN
		TB_Target2025_Tv2 B ON A.czas_ID = B.czas_ID
			         AND A.sklep_ID = B.sklep_ID
					 and a.towar_grupa_m = b.towar_grupa_m

	WHERE
		B.czas_ID IS NULL
		AND B.sklep_ID IS NULL

	)A INNER JOIN SL_Sklep2025_W B ON A.sklep_ID = B.sklep_ID

	
GROUP BY 
	A.czas_ID,
	A.sklep_ID,
a.towar_grupa_m</property>
