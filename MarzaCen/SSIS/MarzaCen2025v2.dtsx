    <DTS:Executable
      DTS:refId="Package\Ustalenie wartości wymaganych parametrów"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:Disabled="True"
      DTS:DTSID="{72B5BAE2-BFF7-49BA-AFB4-358291D7FCDA}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Ustalenie wartości wymaganych parametrów"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{C7C143EC-A6EF-4265-B7CF-51A25D7C7C8B}"
          SQLTask:SqlStatementSource="/*Ustalenie wartosci wymaganych parametrów*/&#xA;&#xA;DECLARE @MiesiacMarzowy INT&#xA;SET @MiesiacMarzowy = ?&#xA;&#xA;IF(@MiesiacMarzowy = 0)&#xA;&#x9;BEGIN&#xA;&#xA;&#x9;&#x9;/*Pobranie parametru @LiczbaMiesiecyWstecz z tabeli konfiguracyjnej*/&#xA;&#x9;&#x9;DECLARE @LiczbaMiesiecyWstecz INT &#xA;&#x9;&#x9;SET @LiczbaMiesiecyWstecz = ?&#xA;&#xA;&#x9;&#x9;/*@Data nie bedzie nigdy mniejsza niz styczen biezacego roku*/&#xA;&#xA;&#x9;&#x9;DECLARE @DataOd SMALLDATETIME&#xA;&#x9;&#x9;SET @DataOd = (CASE &#xA;&#x9;&#x9;&#x9;&#x9;WHEN CONVERT(SMALLDATETIME,CONVERT(NVARCHAR(4),YEAR(GetDate()))+'-01-01') &gt; DATEADD(MONTH,-@LiczbaMiesiecyWstecz,CONVERT(SMALLDATETIME,CONVERT(NVARCHAR(10),GetDate(),121)))&#xA;&#x9;&#x9;&#x9;&#x9;THEN CONVERT(SMALLDATETIME,CONVERT(NVARCHAR(4),YEAR(GetDate()))+'-01-01')&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;ELSE DATEADD(MONTH,-@LiczbaMiesiecyWstecz,CONVERT(SMALLDATETIME,CONVERT(NVARCHAR(10),GetDate(),121)))&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;END)&#xA;&#x9;&#x9;&#x9;&#x9;&#xA;&#x9;&#x9;/*Zwrócenie wartosci parametru @Data na podstawie parametru @LiczbaMiesiecyWstecz*/&#xA;&#xA;&#x9;&#x9;SELECT &#xA;&#x9;&#x9;&#x9;&#x9;CONVERT(SMALLDATETIME,CONVERT(NVARCHAR(7),@DataOd,121)+'-01') AS DataOd,&#xA;&#x9;&#x9;&#x9;&#x9;CONVERT(SMALLDATETIME,CONVERT(NVARCHAR(10),GetDate(),121)) AS DataDo&#xA;&#x9;&#x9;&#xA;&#x9;END&#xA;ELSE&#xA;&#x9;BEGIN&#xA;&#xA;&#x9;&#x9;DECLARE @NumerMiesiacaStyczniaBiezacegoRoku INT&#xA;&#x9;&#x9;SET @NumerMiesiacaStyczniaBiezacegoRoku = (&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;SELECT czas_NumerMiesiaca FROM TB_Czas_T WHERE&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;CONVERT(SMALLDATETIME,CONVERT(NVARCHAR(4),YEAR(GetDate()))+'-01-01') = czas_Data&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;   )&#xA;&#xA;&#x9;&#x9;IF(@MiesiacMarzowy &lt; @NumerMiesiacaStyczniaBiezacegoRoku)&#xA;&#x9;&#x9;&#x9;BEGIN&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;SELECT&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;CONVERT(SMALLDATETIME,MIN(czas_Data)) AS DataOd,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;CONVERT(SMALLDATETIME,MAX(czas_Data)) AS DataDo&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;FROM&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;dbo.TB_Czas_T&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;WHERE&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;czas_NumerMiesiaca = @NumerMiesiacaStyczniaBiezacegoRoku&#xA;&#x9;&#x9;&#x9;END&#xA;&#x9;&#x9;ELSE&#xA;&#x9;&#x9;&#x9;BEGIN&#xA;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;SELECT&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;CONVERT(SMALLDATETIME,MIN(czas_Data)) AS DataOd,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;CONVERT(SMALLDATETIME,MAX(czas_Data)) AS DataDo&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;FROM&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;dbo.TB_Czas_T&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;WHERE&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;czas_NumerMiesiaca = @MiesiacMarzowy&#xA;&#xA;&#x9;&#x9;&#x9;END&#xA;&#xA;&#x9;END"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
