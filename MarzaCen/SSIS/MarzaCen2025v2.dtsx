            <component
              refId="Package\Uzupełnienie słownika SL_Slep_W\OLE DB Source"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="OLE DB Source"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=15.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT

case
when sklepy.ID_SKLEPU is null then v_ps.ID_SKLEPU
else sklepy.ID_SKLEPU end as sklep_ID,

case
when sklepy.ID_SKLEPU is null then convert(varchar(9),right(v_ps.ID_SKLEPU,3))
else  convert(varchar(9),right(sklepy.ID_SKLEPU,3)) end as sklep_nr,

case
when klasyfikacja_sklepow.opis is null then '_brak_danych'
else klasyfikacja_sklepow.opis end as KR,

v_ps.NAZWA_MIASTA as miasto

  FROM [DB_NAME].[dbo].[DRZEWO_KLAS_SKLEPOW]
  join SKLEPY on DRZEWO_KLAS_SKLEPOW.ID_SKLEPU_ALT=sklepy.ID_SKLEPU_ALT
  join KLASYFIKACJA_SKLEPOW on DRZEWO_KLAS_SKLEPOW.ID_KLASY=KLASYFIKACJA_SKLEPOW.ID_KLASY
  full join v_ps on sklepy.id_sklepu=v_ps.id_sklepu

  where V_PS.ID_SKLEPU != '000999' and V_PS.ID_SKLEPU != '000080'
and V_PS.ID_SKLEPU != '000185' and V_PS.ID_SKLEPU != '000213'</property>
                <property
                  dataType="System.String"
                  description="The variable that contains the SQL command to be executed."
                  name="SqlCommandVariable"></property>
                <property
                  dataType="System.Int32"
                  description="Specifies the column code page to use when code page information is unavailable from the data source."
                  name="DefaultCodePage">1250</property>
                <property
                  dataType="System.Boolean"
                  description="Forces the use of the DefaultCodePage property value when describing character data."
                  name="AlwaysUseDefaultCodePage">false</property>
                <property
                  dataType="System.Int32"
                  description="Specifies the mode used to access the database."
                  name="AccessMode"
                  typeConverter="AccessMode">2</property>
                <property
                  dataType="System.String"
                  description="The mappings between the parameters in the SQL command and variables."
                  name="ParameterMapping"></property>
              </properties>
              <connections>
                <connection
                  refId="Package\Uzupełnienie słownika SL_Slep_W\OLE DB Source.Connections[OleDbConnection]"
                  connectionManagerID="Package.ConnectionManagers[SERVER_NAME.DB_NAME.USER_DB_NAME]"
                  connectionManagerRefId="Package.ConnectionManagers[SERVER_NAME.DB_NAME.USER_DB_NAME]"
                  description="The OLE DB runtime connection used to access the database."
                  name="OleDbConnection" />
              </connections>
              <outputs>
                <output
                  refId="Package\Uzupełnienie słownika SL_Slep_W\OLE DB Source.Outputs[OLE DB Source Output]"
                  name="OLE DB Source Output">
                  <outputColumns>
                    <outputColumn
                      refId="Package\Uzupełnienie słownika SL_Slep_W\OLE DB Source.Outputs[OLE DB Source Output].Columns[sklep_ID]"
                      codePage="1250"
                      dataType="str"
                      errorOrTruncationOperation="Conversion"
                      errorRowDisposition="FailComponent"
                      externalMetadataColumnId="Package\Uzupełnienie słownika SL_Slep_W\OLE DB Source.Outputs[OLE DB Source Output].ExternalColumns[sklep_ID]"
                      length="12"
                      lineageId="Package\Uzupełnienie słownika SL_Slep_W\OLE DB Source.Outputs[OLE DB Source Output].Columns[sklep_ID]"
                      name="sklep_ID"
                      truncationRowDisposition="FailComponent" />
                    <outputColumn
                      refId="Package\Uzupełnienie słownika SL_Slep_W\OLE DB Source.Outputs[OLE DB Source Output].Columns[sklep_nr]"
                      codePage="1250"
                      dataType="str"
                      errorOrTruncationOperation="Conversion"
                      errorRowDisposition="FailComponent"
                      externalMetadataColumnId="Package\Uzupełnienie słownika SL_Slep_W\OLE DB Source.Outputs[OLE DB Source Output].ExternalColumns[sklep_nr]"
                      length="12"
                      lineageId="Package\Uzupełnienie słownika SL_Slep_W\OLE DB Source.Outputs[OLE DB Source Output].Columns[sklep_nr]"
                      name="sklep_nr"
                      truncationRowDisposition="FailComponent" />
                    <outputColumn
                      refId="Package\Uzupełnienie słownika SL_Slep_W\OLE DB Source.Outputs[OLE DB Source Output].Columns[KR]"
                      codePage="1250"
