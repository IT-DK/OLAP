      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{EAEBFFF1-B31F-4067-A99E-F4EA9E21EF6F}"
          SQLTask:SqlStatementSource="/*Pobranie parametru @LiczbaDniWstecz z tabeli konfiguracyjnej &#xA;&#xA;DECLARE @LiczbaDniWstecz INT&#xA;SET @LiczbaDniWstecz = ?&#xA;&#xA;&#xA;@Data nie będzie nigdy mniejsza niż styczeń bieżącego roku&#xA;&#xA;DECLARE @Data DATETIME&#xA;SET @Data = (CASE &#xA;  WHEN CONVERT(DATETIME,CONVERT(NVARCHAR(4),YEAR(GetDate()))+'-01-01') &gt; &#xA;&#xA;CONVERT(DATETIME,CONVERT(NVARCHAR(10),GetDate(),121)) - @LiczbaDniWstecz &#xA;  THEN CONVERT(DATETIME,CONVERT(NVARCHAR(4),YEAR(GetDate()))+'-01-01')&#xA;                 ELSE CONVERT(DATETIME,CONVERT(NVARCHAR(10),GetDate(),121)) - @LiczbaDniWstecz&#xA;         END)&#xA;  &#xA;Zwrócenie wartości parametru @Data na podstawie parametru @LiczbaDniWstecz*/&#xA;   &#xA;SELECT '2019-03-01' AS Data"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="Data"
            SQLTask:DtsVariableName="User::Data" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::LiczbaDniWstecz"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
