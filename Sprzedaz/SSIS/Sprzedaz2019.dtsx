            <component
              refId="Package\Uzupełnienie słownika SL_Towar_W\OLE DB Source"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="OLE DB Source"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=15.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT
towary.ID_TOWARU_CENTR as ID_towaru_centr,
convert(nvarchar(30),TOWARY.SYMBOL) as towar_Symbol_ID,

convert (nvarchar(96),TOWARY.NAZWA_TOWARU) as towar_Nazwa,
    
CASE
		WHEN LEN (TOWARY.SYMBOL_PRODUCENTA)=0 OR SYMBOL_PRODUCENTA IS NULL THEN '_Brak Danych'
		ELSE convert(varchar(70),TOWARY.SYMBOL_PRODUCENTA)
	END AS towar_Rodzina,


convert(varchar(30),SL_TYP_TOWAROW.NAZWA_TYPU_TOWARU) as towar_Grupa,

CASE
    WHEN KLASY_TOWAROW.ID_KLASY_NADRZ='173667' THEN 'NM'
    ELSE 'WM'
END as grupa_m

FROM [dbo].[TOWARY]
inner join SL_TYP_TOWAROW on [TOWARY].[ID_TYP_TOWAR]= SL_TYP_TOWAROW.ID_TYP_TOWAR
left join KLASY_TOWAROW on [TOWARY].ID_TOWARU_CENTR=KLASY_TOWAROW.ID_TOWARU_CENTR and KLASY_TOWAROW.ID_KLASYFIKACJI='173666'
where SL_TYP_TOWAROW.ID_TYP_TOWAR != '194'


union all

select

ID_TYTULU as ID_towaru_centr,
symbol + ' ' + '(' + right(id_tytulu,4) + ')' as towar_Symbol_ID,

nazwa as towar_nazwa,

'_brak_danych' as towar_Rodzina,
'PRASA' as towar_Grupa,
'WM' as grupa_m

from KOLD_NUMERY
where TYTUL_GLOWNY='T'

union all

select
'00000000-0000-0000-0000-000000000000' as ID_towaru_centr,
'000000' as towar_Symbol_ID,
'_brak_danych' as towar_Nazwa,
'_brak_danych' as towar_Rodzina,
'PRASA' as towar_Grupa,
'WM' as grupa_m</property>
