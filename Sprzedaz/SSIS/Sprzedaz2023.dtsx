              description="OLE DB Source"
              name="OLE DB Source"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=15.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT

case
when sklepy.ID_SKLEPU is null then v_ps.ID_SKLEPU
else sklepy.ID_SKLEPU end as sklep_ID,

case
when sklepy.ID_SKLEPU is null then convert(varchar(9),right(v_ps.ID_SKLEPU,3))
else  convert(varchar(9),right(sklepy.ID_SKLEPU,3)) end as sklep_nr,

case
when klasyfikacja_sklepow.opis is null then '_brak_danych'
else klasyfikacja_sklepow.opis end as KR,

v_ps.NAZWA_MIASTA as miasto

  FROM [DB_NAME].[dbo].[DRZEWO_KLAS_SKLEPOW]
  join SKLEPY on DRZEWO_KLAS_SKLEPOW.ID_SKLEPU_ALT=sklepy.ID_SKLEPU_ALT
  join KLASYFIKACJA_SKLEPOW on DRZEWO_KLAS_SKLEPOW.ID_KLASY=KLASYFIKACJA_SKLEPOW.ID_KLASY
  full join v_ps on sklepy.id_sklepu=v_ps.id_sklepu

  where V_PS.ID_SKLEPU != '000999' and V_PS.ID_SKLEPU != '000080'</property>
