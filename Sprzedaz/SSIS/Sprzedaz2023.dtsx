              refId="Package\Pobranie danych z bazy aplikacji iCe do tabeli TB_Sprzedaz_T2023\OLE DB Source"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="OLE DB Source"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=15.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">select
IMP_paragony_nag.id_importu  as ID_importu,
towary.ID_TOWARU_CENTR as towar_ID,
 IMP_paragony_POZ.ilosc as ilosc,
 IMP_paragony_POZ.wart_csb as wartosc,
 IMP_paragony_POZ.nazwa_vat as VAT,
 isnull(IMP_paragony_POZ.RABAT_PROCENT,0) as RABAT_PROCENT, 
 isnull(IMP_paragony_POZ.KWOTA_RABATU,0) AS KWOTA_RABATU,
 towary.KOD_KRESKOWY as kod_kreskowy,

convert(date,IMP_paragony_nag.DATA_WYSTAWIENIA) as data_ID,
CONVERT(INT, REPLACE(CONVERT(VARCHAR(8),IMP_paragony_nag.DATA_WYSTAWIENIA, 108),':','')
              ) AS godzina_ID,


IMP_paragony_nag.NR_PARAG as nrParagonu,

 IMP_paragony_NAG.forma_plat as platnosc
 
  from [DB_NAME].[dbo].[IMP_PARAGONY_poz]

 join imp_paragony_nag on IMP_PARAGONY_NAG.ID_PARAG=IMP_PARAGONY_POZ.ID_PARAG
 left join towary on IMP_PARAGONY_poz.ID_TOWARU_CENTR=towary.ID_TOWARU_CENTR
  where convert(date,DATA_WYSTAWIENIA) &gt;='2023-01-01 00:00:00.000' and convert(date,DATA_WYSTAWIENIA) &lt;='2023-12-31 00:00:00.000'
  and towary.ID_TOWARU_CENTR is not null
  and IMP_paragony_POZ.status_az!='a'
  union all

  select
IMP_paragony_nag.id_importu  as ID_importu,
case
when KOLD_NUMERY.NAZWA is null then convert(uniqueidentifier,'00000000-0000-0000-0000-000000000000')
else KOLD_NUMERY.ID_TYTULU end as towar,

 IMP_paragony_POZ.ilosc as ilosc,
 IMP_paragony_POZ.wart_csb as wartosc,
 IMP_paragony_POZ.nazwa_vat as VAT,
 isnull(IMP_paragony_POZ.RABAT_PROCENT,0) as RABAT_PROCENT, 
 isnull(IMP_paragony_POZ.KWOTA_RABATU,0) AS KWOTA_RABATU,
 towary.KOD_KRESKOWY as kod_kreskowy,
 
convert(date,IMP_paragony_nag.DATA_WYSTAWIENIA) as data_ID,
CONVERT(INT, REPLACE(CONVERT(VARCHAR(8),IMP_paragony_nag.DATA_WYSTAWIENIA, 108),':','')
              ) AS godzina_ID,


IMP_paragony_nag.NR_PARAG as nrParagonu,

 IMP_paragony_NAG.forma_plat as platnosc

  from [DB_NAME].[dbo].[IMP_PARAGONY_poz]

 join imp_paragony_nag on IMP_PARAGONY_NAG.ID_PARAG=IMP_PARAGONY_POZ.ID_PARAG
 left join KOLD_NUMERY on IMP_PARAGONY_POZ.ID_TYTULU_PR=KOLD_NUMERY.ID_TYTULU and KOLD_NUMERY.TYTUL_GLOWNY='T'
left join towary on IMP_PARAGONY_poz.ID_TOWARU_CENTR=towary.ID_TOWARU_CENTR
 
where convert(date,DATA_WYSTAWIENIA) &gt;= '2023-01-01 00:00:00.000'
and convert(date,DATA_WYSTAWIENIA) &lt;='2023-12-31 00:00:00.000' and IMP_PARAGONY_POZ.ID_TOWARU_CENTR is null
and IMP_paragony_POZ.status_az!='a'

union all

select 
SPRZEDAZ_POZYCJE.ID_IMPORTU  as ID_importu,
SPRZEDAZ_POZYCJE.ID_towaru_centr,
SPRZEDAZ_POZYCJE.ilosc,
CS_WARTOSC_B,
SPRZEDAZ_POZYCJE.nazwa_vat,
'0' as RABAT_PROCENT, 
 '0' AS KWOTA_RABATU,
SPRZEDAZ_POZYCJE.KOD_KRESKOWY as kod_kreskowy,

convert(date,sprzedaz_pozycje.DATA_UTWORZENIA) as data_ID,
CONVERT(INT, REPLACE(CONVERT(VARCHAR(8),sprzedaz_pozycje.DATA_UTWORZENIA, 108),':','')              ) AS godzina_ID,

'Kor. FV do par.' as nrParagonu,
'gotówka' as platnosc

from 
SPRZEDAZ_POZYCJE
where SPRZEDAZ_POZYCJE.typ_faktury='SK' and SPRZEDAZ_POZYCJE.ID_IMPORTU is not null
and
convert(date,sprzedaz_pozycje.DATA_UTWORZENIA) &gt;= '2023-01-01 00:00:00.000'
and convert(date,sprzedaz_pozycje.DATA_UTWORZENIA) &lt;='2023-12-31 00:00:00.000'</property>
